# Copy to .env. Keep credentials on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision model for screenshot review and text recovery; blank uses OPENAI_MODEL.
OPENAI_VISION_MODEL=gpt-5.4
# Optional: path to an approved PEM CA bundle if your HTTPS proxy needs it.
# Windows trusted certificates are used automatically; verification stays enabled.
# SSL_CERT_FILE=C:/path/to/approved-ca-bundle.pem
# Leave empty to generate a persistent token in data/session-token.txt.
SOP_TOKEN=
SOP_DATA_DIR=data
# Browser for recording: chromium or installed Microsoft Edge (msedge).
SOP_BROWSER_CHANNEL=chromium
SOP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
